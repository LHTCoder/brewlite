# ==============================================================
# BrewLite – mẫu biến môi trường (copy thành .env, KHÔNG commit .env)
# ==============================================================

# ---------- PostgreSQL ----------
POSTGRES_USER=brewlite
POSTGRES_PASSWORD=brewlite_dev_password
POSTGRES_DB=brewlite
POSTGRES_PORT=5432
# URL mà API dùng để kết nối (trong docker-compose host là "db")
DATABASE_URL=postgresql://brewlite:brewlite_dev_password@localhost:5432/brewlite

# ---------- NestJS API ----------
API_PORT=4000
NODE_ENV=development
# Chuỗi bí mật ký JWT – production phải sinh ngẫu nhiên >= 32 ký tự
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=1d
# Danh sách origin được phép gọi API (phân tách bằng dấu phẩy)
CORS_ORIGINS=http://localhost:3000
# Dịch vụ thanh toán mô phỏng: thẻ kết thúc bằng 0002 sẽ bị từ chối
PAYMENT_WALLET_LIMIT=500000
LOG_LEVEL=log

# ---------- Next.js Web ----------
WEB_PORT=3000
# URL API mà trình duyệt gọi tới (public)
NEXT_PUBLIC_API_URL=http://localhost:4000
