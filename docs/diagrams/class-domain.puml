@startuml class-domain
' Class-01: Mô hình miền BrewLite (Task 2.3) – khớp với entity TypeORM trong apps/api/src
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #FBF7F2
  BorderColor #8A5733
  ArrowColor #6E432A
}
skinparam enum {
  BackgroundColor #F3E9DC
}
hide empty methods

enum UserRole {
  CUSTOMER
  STAFF
  MANAGER
}
enum ProductCategory {
  COFFEE
  TEA
  MILK_TEA
  SMOOTHIE
  PASTRY
}
enum OrderStatus {
  PENDING
  PAID
  PREPARING
  READY
  COMPLETED
  CANCELLED
}
enum PaymentMethod {
  WALLET
  CARD
}
enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}
enum PromotionType {
  PERCENT
  FIXED
}
enum LoyaltyTransactionType {
  EARN
  REDEEM
}

class User {
  +id : UUID
  +email : String <<unique>>
  -passwordHash : String
  +fullName : String
  +phone : String?
  +role : UserRole
  +loyaltyPoints : int = 0
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Product {
  +id : UUID
  +name : String
  +description : String?
  +basePrice : int  <<VND>>
  +imageUrl : String?
  +category : ProductCategory
  +isAvailable : boolean = true
  +stock : int = 0
  +createdAt : DateTime
  +updatedAt : DateTime
}

class ProductSize {
  +id : UUID
  +name : String  <<S|M|L>>
  +extraPrice : int = 0
}

class Topping {
  +id : UUID
  +name : String
  +price : int
  +isAvailable : boolean = true
}

class Order {
  +id : UUID
  +code : String <<unique, BL-XXXXX>>
  +status : OrderStatus = PENDING
  +subtotal : int
  +discount : int = 0
  +total : int
  +note : String?
  +createdAt : DateTime
  +updatedAt : DateTime
  --
  +canTransitionTo(next : OrderStatus) : boolean
}

class OrderItem {
  +id : UUID
  +productName : String  <<snapshot>>
  +sizeName : String?
  +toppings : JSON[{id,name,price}]  <<snapshot>>
  +unitPrice : int
  +quantity : int  <<1..20>>
  +lineTotal : int
}

class Payment {
  +id : UUID
  +method : PaymentMethod
  +status : PaymentStatus = PENDING
  +amount : int
  +idempotencyKey : String <<unique>>
  +providerRef : String?
  +failureReason : String?
  +createdAt : DateTime
  +updatedAt : DateTime
}

class Promotion {
  +id : UUID
  +code : String <<unique>>
  +description : String?
  +type : PromotionType
  +value : int
  +minOrderAmount : int = 0
  +maxDiscount : int?
  +isActive : boolean = true
  +startsAt : DateTime?
  +endsAt : DateTime?
  --
  +computeDiscount(subtotal : int) : int
}

class LoyaltyTransaction {
  +id : UUID
  +type : LoyaltyTransactionType
  +points : int  <<+EARN / −REDEEM>>
  +description : String?
  +createdAt : DateTime
}

' ---- Quan hệ & multiplicity ----
User "1" -- "0..*" Order : đặt >
User "1" -- "0..*" LoyaltyTransaction : tích/đổi >
Order "1" *-- "1..*" OrderItem : gồm >
Order "1" -- "0..1" Payment : thanh toán bởi >
Order "0..*" -- "0..1" Promotion : áp dụng >
OrderItem "0..*" --> "0..1" Product : tham chiếu >
Product "1" *-- "0..*" ProductSize : có size >
Product "0..*" -- "0..*" Topping : cho phép >
LoyaltyTransaction "0..*" --> "0..1" Order : phát sinh từ >

User ..> UserRole
Product ..> ProductCategory
Order ..> OrderStatus
Payment ..> PaymentMethod
Payment ..> PaymentStatus
Promotion ..> PromotionType
LoyaltyTransaction ..> LoyaltyTransactionType

note top of OrderItem
  Snapshot tên/giá tại thời điểm đặt
  để lịch sử đơn không đổi khi menu thay đổi.
end note
note right of Payment
  idempotencyKey unique → cùng yêu cầu
  gửi lại không tạo giao dịch thứ hai (FR-09)
end note
note bottom of OrderStatus
  PENDING → PAID | CANCELLED
  PAID → PREPARING | CANCELLED
  PREPARING → READY → COMPLETED
end note
@enduml
