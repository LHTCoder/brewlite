@startuml use-case-checkout
' Sơ đồ use-case phạm vi UC-10 Đặt và thanh toán đơn hàng (Task 1.3)
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FBF7F2
  BorderColor #8A5733
}

actor "Khách hàng\nđã đăng nhập" as Customer
actor "<<system>>\nDịch vụ thanh toán\n(mô phỏng)" as Pay

rectangle "UC-10: Đặt và thanh toán đơn hàng" {
  usecase "UC-10.1: Đặt đơn hàng\n(kiểm tra và trừ tồn kho)" as UC101 #F3E9DC
  usecase "UC-10.2: Thanh toán đơn hàng\n(Ví điện tử / Thẻ ngân hàng mô phỏng)" as UC102 #F3E9DC
  usecase "UC-10.3: Hủy đơn chờ\nthanh toán" as UC103
  usecase "UC-10.4: Theo dõi trạng thái\nđơn hàng" as UC104
  usecase "Áp dụng mã khuyến mãi" as Promo
  usecase "Đăng nhập" as Login
  usecase "Tích điểm thành viên" as Points
  usecase "Thanh toán lại đơn hàng\n(khi giao dịch bị từ chối)" as Retry
}

Customer -- UC101
Customer -- UC102
Customer -- UC103
Customer -- UC104

Promo .> UC101 : <<extend>>
UC101 .> Login : <<include>>
UC102 .> Points : <<include>>
UC103 .> UC102 : <<extend>>
UC102 .> UC104 : <<include>>
UC102 <.. Retry : <<extend>>

UC102 -- Pay
Retry -- Pay
@enduml
