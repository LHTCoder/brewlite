@startuml use-case-checkout
' Sơ đồ use-case phạm vi UC-01 Đặt và thanh toán đơn hàng (Task 1.3)
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FBF7F2
  BorderColor #8A5733
}

actor "Khách hàng\nđã đăng nhập" as Customer
actor "Dịch vụ thanh toán\n(mô phỏng)" as Pay <<system>>

rectangle "UC-01 Đặt và thanh toán đơn hàng" {
  usecase "UC-01.1 Đặt đơn hàng\n(kiểm tra & trừ tồn kho)" as UC11 #F3E9DC
  usecase "UC-01.2 Thanh toán đơn hàng\n(Ví điện tử / Thẻ mô phỏng)" as UC12 #F3E9DC
  usecase "UC-01.3 Hủy đơn\nchờ thanh toán" as UC13
  usecase "UC-01.4 Theo dõi\ntrạng thái đơn hàng" as UC14
  usecase "Áp dụng mã\nkhuyến mãi" as Promo
  usecase "Đăng nhập" as Login
  usecase "Tích điểm\nthành viên" as Points
  usecase "Thanh toán lại\n(khi giao dịch bị từ chối)" as Retry
}

Customer -- UC11
Customer -- UC12
Customer -- UC13
Customer -- UC14

UC11 .> Login : <<include>>
Promo .> UC11 : <<extend>>
UC12 .> Points : <<include>>
Retry .> UC12 : <<extend>>

UC12 -- Pay
Retry -- Pay
@enduml
