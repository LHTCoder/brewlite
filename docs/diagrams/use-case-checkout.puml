@startuml use-case-checkout
' Sơ đồ use-case phạm vi UC-01 Đặt và thanh toán đơn hàng (Task 1.3)
left to right direction
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FBF7F2
  BorderColor #8A5733
}

actor "Khách hàng\nđã đăng nhập" as Customer
actor "Payment Service\n(Ví / Thẻ mô phỏng)" as Pay <<system>>
actor "Nhân viên quầy" as Staff

rectangle "BrewLite – Checkout" {
  usecase "UC-01 Đặt và thanh toán\nđơn hàng" as UC1 #F3E9DC
  usecase "UC-01.1 Áp dụng mã\nkhuyến mãi" as UC11
  usecase "UC-01.2 Kiểm tra tồn kho\n& tính giá" as UC12
  usecase "UC-01.3 Tạo đơn hàng\n(PENDING)" as UC13
  usecase "UC-01.4 Thanh toán\n(idempotent)" as UC14
  usecase "UC-01.5 Tích điểm thưởng" as UC15
  usecase "UC-06 Đăng nhập" as UC6
  usecase "UC-09 Hủy đơn\nchưa thanh toán" as UC9
  usecase "UC-07 Theo dõi\ntrạng thái đơn" as UC7
}

Customer --> UC1
Customer --> UC9
Customer --> UC7

UC1 .> UC6 : <<include>>\n(PRE-1)
UC1 .> UC12 : <<include>>
UC1 .> UC13 : <<include>>
UC1 .> UC14 : <<include>>
UC11 .> UC1 : <<extend>>\n[có mã KM]
UC15 .> UC14 : <<extend>>\n[thanh toán thành công]
UC9 .> UC14 : <<extend>>\n[thanh toán thất bại]
UC7 .> UC1 : <<extend>>\n[sau xác nhận]

UC14 --> Pay
UC13 ..> Staff : đơn PAID xuất hiện\ntrên màn hình quầy

note right of UC12
  FR-05 Kiểm tra tồn kho (FOR UPDATE)
  FR-06 Server tính lại giá
end note
note right of UC14
  FR-08 Ví/Thẻ mô phỏng
  FR-09 Idempotency key
end note
@enduml
