@startuml activity-cart
' Activity-03: Quản lý giỏ hàng và tính tổng tiền (FR-03)
skinparam ActivityBackgroundColor #FBF7F2
skinparam ActivityBorderColor #8A5733
skinparam ActivityDiamondBackgroundColor #F3E9DC
|Khách hàng|
start
:Nhấn "Thêm vào giỏ" từ chi tiết sản phẩm;
|Next.js UI (store/cart)|
:Tính key = productId | sizeId | toppingIds (đã sắp xếp);
if (Đã có dòng cùng key?) then (có)
  :Cộng dồn số lượng (không vượt tồn kho);
else (chưa)
  :Thêm dòng mới {sản phẩm, size, topping, số lượng, maxStock};
endif
:Lưu giỏ vào localStorage (persist);
:Hiển thị toast "Đã thêm … vào giỏ", cập nhật badge;
|Khách hàng|
:Mở tab Giỏ hàng;
|Next.js UI (store/cart)|
if (Giỏ trống?) then (trống)
  :Empty state "Giỏ hàng trống" + nút "Xem menu";
  stop
else (có món)
  :Hiển thị từng dòng: tên, size, topping, đơn giá, số lượng, thành tiền;
  :Tạm tính = Σ (đơn giá × số lượng);
endif
|Khách hàng|
repeat
  |Next.js UI (store/cart)|
  switch (Thao tác?)
  case (Tăng)
    |Next.js UI (store/cart)|
    if (số lượng < tồn kho?) then (có)
      :Số lượng + 1;
    else (không)
      :Nút "+" bị vô hiệu;
    endif
  case (Xóa)
    |Next.js UI (store/cart)|
    :Xóa dòng;
  case (Giảm)
    |Next.js UI (store/cart)|
    if (số lượng − 1 = 0?) then (có)
      :Xóa dòng;
    else (không)
      :Số lượng − 1;
    endif
  case (Không làm gì)
    |Next.js UI (store/cart)|
    :Không thay đổi;
  endswitch
  |Next.js UI (store/cart)|
  :Tính lại tạm tính; lưu localStorage;
  if (Giỏ trống?) then (trống)
    :Empty state "Giỏ hàng trống" + nút "Xem menu";
    stop
  else (còn món)
  endif
  |Khách hàng|
backward :Chọn thao tác khác;
repeat while (Tiếp tục chỉnh?) is (có) not (không)
:Nhấn "Đặt đơn";
|Next.js UI (store/cart)|
if (Đã đăng nhập?) then (chưa)
  :Chuyển /login?next=/checkout (giỏ vẫn giữ) → Activity-04;
else (rồi)
  :Chuyển /checkout → Activity-01;
endif
stop
@enduml
