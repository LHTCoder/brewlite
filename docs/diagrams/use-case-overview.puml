@startuml use-case-overview
' Sơ đồ use-case tổng quát hệ thống BrewLite (SRS §2)
' Liên kết actor – use-case là đường thẳng (association); quan hệ include/extend thể hiện ở sơ đồ UC-01
left to right direction
skinparam packageStyle rectangle
skinparam actorStyle awesome
skinparam usecase {
  BackgroundColor #FBF7F2
  BorderColor #8A5733
}

actor "Khách hàng" as Guest
actor "Khách hàng\nđã đăng nhập" as Customer
actor "Nhân viên quầy" as Staff
actor "Quản lý" as Manager
actor "Payment Service\n(mô phỏng)" as Pay <<system>>

Customer -|> Guest
Manager -|> Staff

rectangle "BrewLite" {
  usecase "UC-02 Xem menu" as UC2
  usecase "UC-03 Xem chi tiết\nsản phẩm" as UC3
  usecase "UC-04 Quản lý giỏ hàng" as UC4
  usecase "UC-05 Đăng ký" as UC5
  usecase "UC-06 Đăng nhập" as UC6
  usecase "UC-01 Đặt và thanh toán\nđơn hàng" as UC1 #F3E9DC
  usecase "UC-07 Theo dõi\ntrạng thái đơn" as UC7
  usecase "UC-08 Xem lịch sử đơn" as UC8
  usecase "UC-09 Hủy đơn\nchưa thanh toán" as UC9
  usecase "UC-10 Xem điểm thành viên" as UC10
  usecase "UC-11 Xem đơn\ncần xử lý" as UC11
  usecase "UC-12 Cập nhật\ntrạng thái đơn" as UC12
  usecase "UC-13 Quản lý menu &\nkhuyến mãi (Could)" as UC13
}

Guest -- UC2
Guest -- UC3
Guest -- UC4
Guest -- UC5
Guest -- UC6

Customer -- UC1
Customer -- UC7
Customer -- UC8
Customer -- UC9
Customer -- UC10

Staff -- UC11
Staff -- UC12
Manager -- UC13

UC1 -- Pay

@enduml
